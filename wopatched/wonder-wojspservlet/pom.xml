<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>wopatched</groupId>
		<artifactId>wopatched</artifactId>
		<version>7.3.12</version>
	</parent>
	<artifactId>wonder-wojspservlet</artifactId>
	<packaging>jar</packaging>

	<name>WebObjects Patched - WOJSPServlet</name>
	<description>Drop-in replacement for com.webobjects:JavaWOJSPServlet:5.4.3. Shade-merges the original jar with wopatches7:wojspservlet-patches (which overrides _WOApplicationWrapper), with an explicit filter excluding the overridden class from the original jar. JavaWOJSPServlet's own published pom declares no dependencies at all, so (matching wopatches7's own wojspservlet-patches pom) the needed layers are declared explicitly here rather than relying on inherited transitivity. com.webobjects:JavaXML is not needed: an exhaustive scan of all 13 classes in the jar found zero references to any JavaXML-exclusive package.</description>

	<!-- JavaWOJSPServlet and wojspservlet-patches are fully shade-merged into this jar's output
	     (see artifactSet/includes below), so they are marked optional=true to avoid leaking the
	     original com.webobjects:JavaWOJSPServlet jar transitively to consumers (which would
	     otherwise race against this self-contained jar for the same com.webobjects.jspservlet.*
	     class names). foundation/eocontrol/webobjects are genuine runtime dependencies (not
	     shaded in), so they stay at compile scope. -->
	<dependencies>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaWOJSPServlet</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wopatches7</groupId>
			<artifactId>wojspservlet-patches</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-foundation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-eocontrol</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-webobjects</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<artifactSet>
								<includes>
									<include>com.webobjects:JavaWOJSPServlet</include>
									<include>wopatches7:wojspservlet-patches</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>com.webobjects:JavaWOJSPServlet</artifact>
									<excludes>
										<exclude>META-INF/INDEX.LIST</exclude>
										<exclude>com/webobjects/jspservlet/_WOApplicationWrapper.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
