<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>wopatched</groupId>
		<artifactId>wopatched</artifactId>
		<version>2.0.0</version>
	</parent>
	<artifactId>wonder-webobjects</artifactId>
	<packaging>jar</packaging>

	<name>WebObjects Patched - WebObjects</name>
	<description>Drop-in replacement for com.webobjects:JavaWebObjects:5.4.3. Shade-merges the original jar with wonder.core:ERWebObjects (which overrides the WOBundle/_ideservices subsystem) and wopatches7:webobjects-patches (which overrides WOCookie/WODisplayGroup/_private.WOCGIFormValues/_private.WOResourceRequestHandler/xml.WOXMLCoder/xml.WOXMLDecoder/KeyValueCodingProtectedAccessor), with explicit filters excluding the overridden classes from the original jar. com.webobjects:JavaXML (which embeds a full legacy 2005-2008-era Apache Axis 1.x/WSDL4J/Xalan/Xerces/BCEL/Log4j1 stack) is dropped entirely: an exhaustive scan of all 315 JavaWebObjects classes found only 15 referencing JavaXML-exclusive packages, of which 3 (WOXMLCoder/WOXMLDecoder/WOCGIFormValues$Encoder) are already neutralized by webobjects-patches, and the remaining 12 are the dead legacy Axis-based WOWebService/WSDD/RPC direct-action subsystem (never used in practice, and wonder's own WOWebServicePatch.java/ERXApplication call site were removed accordingly). Matches org.wocommunity:wonder-modular-webobjects's approach exactly.</description>

	<!-- JavaWebObjects, ERWebObjects and webobjects-patches are fully shade-merged into this
	     jar's output (see artifactSet/includes below), so they are marked optional=true to avoid
	     leaking the original com.webobjects:JavaWebObjects jar transitively to consumers (which
	     would otherwise race against this self-contained jar for the same
	     com.webobjects.appserver.* class names). foundation/eocontrol are genuine runtime
	     dependencies (not shaded in), so they stay at compile scope. -->
	<dependencies>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaWebObjects</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wonder.core</groupId>
			<artifactId>ERWebObjects</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wopatches7</groupId>
			<artifactId>webobjects-patches</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-foundation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-eocontrol</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- Generate one explicit manifest instead of arbitrarily keeping one of the several
							     merged jars' own manifests (silences the shade-plugin "overlapping resource
							     META-INF/MANIFEST.MF" warning). -->
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer" />
							</transformers>
							<artifactSet>
								<includes>
									<include>com.webobjects:JavaWebObjects</include>
									<include>wonder.core:ERWebObjects</include>
									<include>wopatches7:webobjects-patches</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<!-- Every merged jar carries its own META-INF/MANIFEST.MF; exclude it from all of
									     them here (the ManifestResourceTransformer above generates the single output
									     one) so shade doesn't warn about an "overlapping resource" it's actually
									     handling deterministically. -->
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/MANIFEST.MF</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>com.webobjects:JavaWebObjects</artifact>
									<excludes>
										<exclude>META-INF/INDEX.LIST</exclude>
										<!-- overridden by wopatches7:webobjects-patches -->
										<exclude>com/webobjects/appserver/WOCookie.class</exclude>
										<exclude>com/webobjects/appserver/WODisplayGroup.class</exclude>
										<exclude>com/webobjects/appserver/WODisplayGroup$Delegate.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOCGIFormValues.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOCGIFormValues$Decoder.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOCGIFormValues$Encoder.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOResourceRequestHandler.class</exclude>
										<exclude>com/webobjects/appserver/xml/WOXMLCoder.class</exclude>
										<exclude>com/webobjects/appserver/xml/WOXMLCoder$_IdentityCodeMap.class</exclude>
										<exclude>com/webobjects/appserver/xml/WOXMLDecoder.class</exclude>
										<!-- dropped: com.webobjects:JavaXML no longer a dependency; these are the dead legacy
										     Apache Axis-based WOWebService/WSDD/RPC direct-action subsystem (no patched replacement
										     exists because it was never used/supported; wonder's own WOWebServicePatch.java and its
										     ERXApplication call site were removed to match). Matches wonder-modular-webobjects's filter. -->
										<exclude>com/webobjects/appserver/_WODocumentType.class</exclude>
										<exclude>com/webobjects/appserver/_WOMessageHelper.class</exclude>
										<exclude>com/webobjects/appserver/WOWSDDRegistrar.class</exclude>
										<exclude>com/webobjects/appserver/WOWSDDRegistrar$Delegate.class</exclude>
										<exclude>com/webobjects/appserver/WOWebServiceRegistrar.class</exclude>
										<exclude>com/webobjects/appserver/WOWebServiceUtilities.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOAxisSession.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOComponentSerializer.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOComponentSerializerFactory.class</exclude>
										<exclude>com/webobjects/appserver/_private/WORPCProvider.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOServerSessionHandler.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOWebService.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOWebService$NullTransformer.class</exclude>
										<!-- NOT excluded (kept): WOWebServiceRequestHandler.class - despite being part of the dead
										     Axis-based webservices subsystem, WOApplication._registerRequestHandlers() has a hard
										     bytecode-level reference to it (a local variable of this type). Since Java 6+ bytecode
										     verification (StackMapTable) resolves every type referenced anywhere in a class's
										     methods at class-load time - even in code paths that never execute - excluding this
										     class made WOApplication itself fail to link: NSBundle's static initializer eagerly
										     loads WOApplication (as the appserver framework's NSPrincipalClass), triggering
										     verification, triggering NoClassDefFoundError, which permanently poisons NSBundle's
										     class state for the rest of the JVM's life. Confirmed via bytecode scan that none of
										     the other 7 excluded classes here are referenced by any of the 306 kept classes, so
										     only this one needs to stay. -->
										<!-- stray duplicate: original jar has a buggy copy of this class in the default/root
										     package (unrelated to JavaXML); webobjects-patches provides the correctly
										     packaged com/webobjects/appserver/ version. Also excluded by wonder-modular-webobjects. -->
										<exclude>KeyValueCodingProtectedAccessor.class</exclude>
										<!-- overridden by wonder.core:ERWebObjects (WOBundle/_ideservices subsystem) -->
										<exclude>com/webobjects/appserver/_private/WOBundle.class</exclude>
										<exclude>com/webobjects/appserver/_private/WODeployedBundle.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOProjectBundle.class</exclude>
										<exclude>com/webobjects/appserver/_private/WOProjectBundle$PBWOProjectAndDirFilter.class</exclude>
										<exclude>com/webobjects/_ideservices/_IDEProject.class</exclude>
										<exclude>com/webobjects/_ideservices/_IDEProjectPB.class</exclude>
										<exclude>com/webobjects/_ideservices/_IDEProjectPBX.class</exclude>
										<exclude>com/webobjects/_ideservices/_IDEProjectWOLips.class</exclude>
										<exclude>com/webobjects/_ideservices/_PBProject.class</exclude>
										<exclude>com/webobjects/_ideservices/_PBXProjectWatcher.class</exclude>
										<exclude>com/webobjects/_ideservices/_WOAntProject.class</exclude>
										<exclude>com/webobjects/_ideservices/_WOLaunchServices.class</exclude>
										<exclude>com/webobjects/_ideservices/_WOLipsProject.class</exclude>
										<exclude>com/webobjects/_ideservices/_WOProject.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
