<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>wopatched</groupId>
		<artifactId>wopatched</artifactId>
		<version>1.0</version>
	</parent>
	<artifactId>wonder-eoaccess</artifactId>
	<packaging>jar</packaging>

	<name>WebObjects Patched - EOAccess</name>
	<description>Drop-in replacement for com.webobjects:JavaEOAccess:5.4.3. Shade-merges the original jar with wopatches7:eoaccess-patches (which overrides EOAttribute/_EOExpressionArray and adds ERXAdaptorOpComparator/ERXEOAccessHelper/ERXEntity/ERXEntityDependencyOrderingDelegate/ERXEntityFKConstraintOrder/ERXEntityOrder/ERXModel/ERXSingleValueID/KeyValueCodingProtectedAccessor), with explicit filters excluding the overridden classes from the original jar. Depends on the patched "wonder-foundation" and "wonder-eocontrol" artifacts at runtime, mirroring JavaEOAccess's own dependencies.</description>

	<!-- JavaEOAccess and eoaccess-patches are fully shade-merged into this jar's output (see
	     artifactSet/includes below), so they are marked optional=true to avoid leaking the original
	     com.webobjects:JavaEOAccess jar transitively to consumers (which would otherwise race
	     against this self-contained jar for the same com.webobjects.eoaccess.* class names).
	     foundation/eocontrol are genuine runtime dependencies (not shaded in), so they stay at
	     compile scope. -->
	<dependencies>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaEOAccess</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wopatches7</groupId>
			<artifactId>eoaccess-patches</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-foundation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>wopatched</groupId>
			<artifactId>wonder-eocontrol</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- Generate one explicit manifest instead of arbitrarily keeping one of the several
							     merged jars' own manifests (silences the shade-plugin "overlapping resource
							     META-INF/MANIFEST.MF" warning). -->
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer" />
							</transformers>
							<artifactSet>
								<includes>
									<include>com.webobjects:JavaEOAccess</include>
									<include>wopatches7:eoaccess-patches</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<!-- Every merged jar carries its own META-INF/MANIFEST.MF; exclude it from all of
									     them here (the ManifestResourceTransformer above generates the single output
									     one) so shade doesn't warn about an "overlapping resource" it's actually
									     handling deterministically. -->
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/MANIFEST.MF</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>com.webobjects:JavaEOAccess</artifact>
									<excludes>
										<exclude>META-INF/INDEX.LIST</exclude>
										<exclude>com/webobjects/eoaccess/EOAttribute.class</exclude>
										<exclude>com/webobjects/eoaccess/EOAttribute$Characteristic.class</exclude>
										<exclude>com/webobjects/eoaccess/_EOExpressionArray.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
