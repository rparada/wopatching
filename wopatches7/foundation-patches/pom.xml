<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>wopatches7</groupId>
		<artifactId>wopatches7</artifactId>
		<version>1.0</version>
	</parent>
	<artifactId>foundation-patches</artifactId>

	<name>Foundation Patches</name>
	<description>Patched classes for com.webobjects.foundation, reconciled from Project Wonder and the WOCommunity wopatches project.</description>

	<licenses>
		<license>
			<name>NetStruxr Public Software License</name>
			<url>https://github.com/wocommunity/wonder/blob/master/Frameworks/Core/ERExtensions/Documentation/LICENSE.NPL</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Ricardo Parada</name>
			<email>rparada@mac.com</email>
		</developer>
	</developers>

	<!-- wonder.core:ERFoundation must come before com.webobjects:JavaFoundation on the compile
	     classpath: both jars define com.webobjects.foundation.NSBundle, and this patch class
	     needs the ERFoundation variant (with its additional package-private
	     _normalizeExistingBundlePath/_lookupBundleWithPath/_cleanNormalizedBundlePath/
	     _userAndBundleProperties/_bundleOrAppForName helper methods) to resolve at compile time. -->
	<dependencies>
		<dependency>
			<groupId>wonder.core</groupId>
			<artifactId>ERFoundation</artifactId>
		</dependency>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaFoundation</artifactId>
		</dependency>
	</dependencies>
</project>
